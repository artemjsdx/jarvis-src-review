  {
   "name": "chat screens: 10 actions, icon strip (dark)",
   "requires": [
    "destructive"
   ],
   "needs": [
    "chat_seed",
    "perf_frames",
    "sessions_create",
    "ui_navigate",
    "ui_screenshot"
   ],
   "steps": [
    {
     "call": "ui_theme",
     "args": {
      "mode": "dark"
     }
    },
    {
     "call": "sessions_create",
     "args": {
      "title": "Шот: десять действий"
     },
     "save": {
      "sid": "$.id"
     }
    },
    {
     "call": "chat_seed",
     "args": {
      "session": "${sid}",
      "items": [
       {
        "kind": "user",
        "text": "Проверь все системы и покажи, что нашёл"
       },
       {
        "kind": "tool",
        "tool": "fs_list",
        "args": {
         "path": "."
        },
        "summary": "Список из 14 файлов",
        "ms": 150,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "fs_stat",
        "args": {
         "path": "покупки.txt"
        },
        "summary": "Размер 13 Б",
        "ms": 190,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "fs_read",
        "args": {
         "path": "покупки.txt"
        },
        "summary": "Прочитано 13 символов",
        "ms": 230,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "memory_get",
        "args": {
         "key": "таймер"
        },
        "summary": "Найдено",
        "ms": 270,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "memory_search",
        "args": {
         "query": "погода"
        },
        "summary": "2 записи",
        "ms": 310,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "web_fetch",
        "args": {
         "url": "https://example.com"
        },
        "summary": "Загружено 0,8 КБ",
        "ms": 350,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "docs_search",
        "args": {
         "query": "мост"
        },
        "summary": "5 фрагментов",
        "ms": 390,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "shell_exec",
        "args": {
         "cmd": "uptime"
        },
        "summary": "Код выхода 0",
        "ms": 430,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "http_fetch",
        "args": {
         "url": "https://example.com/health"
        },
        "summary": "Сервер ответил 503",
        "ms": 470,
        "ok": false,
        "result": {
         "ok": false,
         "error": "Сервер ответил 503"
        }
       },
       {
        "kind": "tool",
        "tool": "download",
        "args": {
         "url": "https://example.com/a.zip"
        },
        "summary": "Не удалось скачать",
        "ms": 510,
        "ok": false,
        "result": {
         "ok": false,
         "error": "Не удалось скачать"
        }
       },
       {
        "kind": "assistant",
        "text": "Проверил: восемь действий прошли, два не сработали: сервер проверки отвечает 503, загрузка не удалась.",
        "model": "deepseek/deepseek-v4.1-flash"
