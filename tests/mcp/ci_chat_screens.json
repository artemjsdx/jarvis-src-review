  {
   "name": "chat screens: 3 parallel actions, collapsed (dark)",
   "requires": [
    "destructive"
   ],
   "needs": [
    "chat_seed",
    "perf_frames",
    "sessions_create",
    "ui_navigate",
    "ui_screenshot"
   ],
   "steps": [
    {
     "call": "ui_theme",
     "args": {
      "mode": "dark"
     }
    },
    {
     "call": "sessions_create",
     "args": {
      "title": "Шот: три действия"
     },
     "save": {
      "sid": "$.id"
     }
    },
    {
     "call": "chat_seed",
     "args": {
      "session": "${sid}",
      "items": [
       {
        "kind": "user",
        "text": "Сделай три дела: запиши «молоко, хлеб» в файл покупок, проверь погоду в Минске и сохрани заметку о таймере"
       },
       {
        "kind": "tool",
        "tool": "fs_write",
        "args": {
         "path": "покупки.txt",
         "text": "молоко, хлеб"
        },
        "summary": "Записано 13 символов в покупки.txt",
        "ms": 340,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "web_fetch",
        "args": {
         "url": "https://wttr.in/Minsk?format=3"
        },
        "summary": "Загружено 1,2 КБ",
        "ms": 1210,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "tool",
        "tool": "memory_save",
        "args": {
         "key": "таймер",
         "value": "5 минут"
        },
        "summary": "Сохранено в памяти",
        "ms": 90,
        "ok": true,
        "result": {
         "ok": true
        }
       },
       {
        "kind": "assistant",
        "text": "Готово: список покупок записан, в Минске +12 °C, облачно, заметка о таймере сохранена.",
        "model": "deepseek/deepseek-v4.1-flash"
       }
      ]
     }
    },
    {
     "call": "ui_navigate",
     "args": {
      "screen": "agent"
     }
    },
    {
     "call": "ui_wait",
     "args": {
      "selector": {
       "desc": "Прикрепить"
      },
      "timeoutMs": 20000
     }
    },
    {
     "call": "ui_screenshot",
     "args": {
      "scale": 0.5
     },
     "expect": [
      {
       "path": "@images",
       "eq": 1
      }
     ]
    }
   ]
