{"scenarios":[
 {"name":"voice_stt_file needs a path or base64",
  "needs":["voice_stt_file"],
  "steps":[{"call":"voice_stt_file","args":{},"expectError":"INVALID_ARGS"}]},
 {"name":"voice_stt_file refuses paths outside the sandbox and app files",
  "needs":["voice_stt_file"],
  "steps":[{"call":"voice_stt_file","args":{"path":"../../../../etc/passwd"},"expectError":"FORBIDDEN"}]},
 {"name":"voice_stt_file reports a missing file",
  "needs":["voice_stt_file"],
  "steps":[{"call":"voice_stt_file","args":{"path":"work/no-such-file.wav"},"expectError":"NOT_FOUND"}]},
 {"name":"voice_stt_file transcribes a spoken WAV (real chain, phone only)",
  "needs":["voice_speak","voice_stt_file"],
  "jvm":false,
  "steps":[{"call":"voice_speak","args":{"text":"Привет, это проверка распознавания.","provider":"gtts","output":"file"},"save":{"p":"$.path"}},
    {"call":"voice_stt_file","args":{"path":"$p"},
     "expect":[{"path":"$.text","contains":"проверка","ci":true},{"path":"$.attempts","gte":1},{"path":"$.format.sampleRate","eq":16000}]}]}
]}
