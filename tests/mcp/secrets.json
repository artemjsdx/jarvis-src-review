{
 "scenarios": [
  {
   "name": "names and last four characters only",
   "steps": [
    {
     "call": "secrets_set",
     "args": {
      "name": "smoke.secret",
      "value": "sk-smoke-0123456789abcdef-${rand}"
     },
     "expect": [
      {
       "path": "$.stored",
       "eq": true
      }
     ]
    },
    {
     "call": "secrets_list",
     "expect": [
      {
       "path": "@text",
       "contains": "smoke.secret"
      },
      {
       "path": "@text",
       "ne": "x"
      }
     ]
    },
    {
     "call": "secrets_get",
     "args": {
      "name": "smoke.secret"
     },
     "expectError": "FORBIDDEN"
    }
   ],
   "needs": [
    "secrets_set",
    "secrets_list",
    "secrets_get"
   ],
   "gate": "destructive_off"
  },
  {
   "name": "get returns the value when allowed",
   "steps": [
    {
     "call": "secrets_set",
     "args": {
      "name": "smoke.secret",
      "value": "sk-smoke-0123456789abcdef-${rand}"
     }
    },
    {
     "call": "secrets_get",
     "args": {
      "name": "smoke.secret"
     },
     "expect": [
      {
       "path": "$.value",
       "contains": "sk-smoke-0123456789abcdef"
      }
     ]
    }
   ],
   "needs": [
    "secrets_get"
   ],
   "gate": "destructive_on"
  }
 ]
}