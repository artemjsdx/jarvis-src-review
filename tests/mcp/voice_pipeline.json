{"scenarios":[
 {"name":"voice_state reports the pipeline",
  "needs":["voice_state"],
  "steps":[{"call":"voice_state","args":{},"expect":[{"path":"$.state","exists":true},{"path":"$.allowAudio","exists":true},{"path":"$.micActive","exists":true}]}]},
 {"name":"mic_level needs mcp.allowAudio",
  "needs":["mic_level"],
  "gate":"audio_off",
  "steps":[{"call":"mic_level","args":{},"expectError":"FORBIDDEN"}]},
 {"name":"voice_inject needs a path or base64",
  "needs":["voice_inject"],
  "steps":[{"call":"voice_inject","args":{},"expectError":"INVALID_ARGS"}]},
 {"name":"voice_inject reports a missing file",
  "needs":["voice_inject"],
  "steps":[{"call":"voice_inject","args":{"path":"work/no-such-file.wav"},"expectError":"NOT_FOUND"}]},
 {"name":"voice_inject speak=true needs mcp.allowAudio",
  "needs":["voice_inject"],
  "gate":"audio_off",
  "steps":[{"call":"voice_inject","args":{"base64":"AAAA","speak":true},"expectError":"FORBIDDEN"}]},
 {"name":"spoken command goes through segmenter, STT, agent and back to a file (phone only, needs LLM key)",
  "needs":["voice_speak","voice_inject"],
  "jvm":false,
  "needsLlm":true,
  "steps":[{"call":"voice_speak","args":{"text":"Какая сегодня погода?","provider":"gtts","output":"file"},"save":{"p":"$.path"}},
    {"call":"voice_inject","args":{"path":"$p","mode":"command"},
     "expect":[{"path":"$.transcript","contains":"погод","ci":true},{"path":"$.reply","len_gte":1},{"path":"$.ttsPath","exists":true},{"path":"$.turn.marks","exists":true}]}]}
]}
